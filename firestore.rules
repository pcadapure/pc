rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registro_diario_inspecciones/{date} {
      allow read, write: if request.auth != null && request.auth.token.email_verified == true;
    }

    match /visitas_contenido_diarias/{date}/items/{itemId} {
      function validCounter() {
        return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasAll(['kind', 'title', 'views'])
          && request.resource.data.keys().hasOnly(['kind', 'title', 'views'])
          && request.resource.data.kind in ['articulo', 'publicacion']
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 140
          && request.resource.data.views is int
          && request.resource.data.views >= 1
          && request.resource.data.views <= 10000000
          && (
            (request.resource.data.kind == 'articulo' && itemId.matches('^articulo--[A-Za-z0-9_-]{1,120}$'))
            || (request.resource.data.kind == 'publicacion' && itemId.matches('^publicacion--[A-Za-z0-9_-]{1,120}$'))
          );
      }

      allow read: if true;
      allow create: if validCounter() && request.resource.data.views == 1;
      allow update: if validCounter()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && resource.data.views is int
        && request.resource.data.views == resource.data.views + 1;
      allow delete: if false;
    }
  }
}
